PORT=5000
CLIENT_URL=http://localhost:8080
# random 32+ byte string
SESSION_SECRET=
# GitHub OAuth App (callback URL: http://localhost:5000/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Token used only for reading public contribution counts (a fine-grained token with no scopes is enough)
GITHUB_API_TOKEN=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
USER_DATABASE_ADDRESS=
# Must hold ATTESTER_ROLE in UserDatabase (signs only, never sends transactions)
ATTESTER_PRIVATE_KEY=
# Must hold XP_UPDATER_ROLE in UserDatabase and some Sepolia ETH for gas
XP_UPDATER_PRIVATE_KEY=
SYNC_INTERVAL_MINUTES=360
MANUAL_SYNC_COOLDOWN_SECONDS=600
SYNC_BATCH_SIZE=100
